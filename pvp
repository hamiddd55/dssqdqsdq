local function getHRP(model)
    if not model or not model:FindFirstChild("HumanoidRootPart") then return nil end
    return model.HumanoidRootPart
end

local function getPredictedPosition(hrp)
    if not hrp then return nil end
    local humanoid = hrp.Parent:FindFirstChildOfClass("Humanoid")
    if not humanoid then return hrp.Position end
    if not CONFIG.SilentAimPrediction or humanoid.WalkSpeed < 5 then return hrp.Position end
    return hrp.Position + (hrp.Velocity * CONFIG.SilentAimPredAmount)
end

local function isAllyWithMe(targetplayer)
    local myGui = lp:FindFirstChild("PlayerGui")
    if not myGui then return false end
    local scrolling = myGui:FindFirstChild("Main")
        and myGui.Main:FindFirstChild("Allies")
        and myGui.Main.Allies:FindFirstChild("Container")
        and myGui.Main.Allies.Container:FindFirstChild("Allies")
        and myGui.Main.Allies.Container.Allies:FindFirstChild("ScrollingFrame")
    if scrolling then
        for _, frame in pairs(scrolling:GetDescendants()) do
            if frame:IsA("ImageButton") and frame.Name == targetplayer.Name then return true end
        end
    end
    return false
end

local function isSAEnemy(targetplayer)
    if not targetplayer or targetplayer == lp then return false end
    local myTeam, targetTeam = lp.Team, targetplayer.Team
    if myTeam and targetTeam then
        if myTeam.Name == "Pirates" and targetTeam.Name == "Marines" then return true end
        if myTeam.Name == "Marines" and targetTeam.Name == "Pirates" then return true end
        if myTeam.Name == "Pirates" and targetTeam.Name == "Pirates" then return not isAllyWithMe(targetplayer) end
        if myTeam.Name == "Marines" and targetTeam.Name == "Marines" then return false end
    end
    return true
end

local function getClosestPlayerForSA(lpHRP)
    if not lpHRP then return nil end
    local closest, closestDist = nil, math.huge
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= lp and isSAEnemy(pl) and pl.Character and pl.Character.Parent then
            local hum = pl.Character:FindFirstChildWhichIsA("Humanoid")
            local hrp = getHRP(pl.Character)
            if hum and hum.Health > 0 and hrp then
                local d = (hrp.Position - lpHRP.Position).Magnitude
                if d <= CONFIG.SilentAimMaxRange and d < closestDist then
                    closestDist = d; closest = pl
                end
            end
        end
    end
    return closest
end

local function getClosestNPCForSA(lpHRP)
    if not lpHRP then return nil end
    local enemiesFolder = Workspace:FindFirstChild("Enemies")
    if not enemiesFolder then return nil end
    local closest, closestDist = nil, math.huge
    for _, npc in ipairs(enemiesFolder:GetChildren()) do
        if npc:IsA("Model") then
            local hum = npc:FindFirstChildWhichIsA("Humanoid")
            local hrp = getHRP(npc)
            if hum and hum.Health > 0 and hrp then
                local d = (hrp.Position - lpHRP.Position).Magnitude
                if d <= CONFIG.SilentAimMaxRange and d < closestDist then
                    closestDist = d; closest = npc
                end
            end
        end
    end
    return closest
end

local function applySAHighlight(model, kind)
    if not CONFIG.SilentAimHighlight then return end
    if not model then return end
    if SA.Highlight and SA.Highlight.Adornee == model then return end
    if SA.Highlight then SA.Highlight:Destroy(); SA.Highlight = nil end
    local hl = Instance.new("Highlight")
    hl.FillColor = Color3.fromRGB(255, 255, 0)
    hl.OutlineColor = Color3.fromRGB(255, 255, 0)
    hl.FillTransparency = 0.5
    hl.OutlineTransparency = 0
    hl.Adornee = model
    hl.Parent = model
    SA.Highlight = hl
    SA.HighlightType = kind
end

local function clearSAHighlight()
    if SA.Highlight then SA.Highlight:Destroy(); SA.Highlight = nil; SA.HighlightType = nil end
end

local function isSkillReadyForTool(toolName)
    if not toolName then return false end
    local playerGui = lp:FindFirstChild("PlayerGui")
    if not playerGui then return false end
    local skillsFolder = playerGui:FindFirstChild("Main") and playerGui.Main:FindFirstChild("Skills")
    if not skillsFolder then return false end
    local toolFrame = skillsFolder:FindFirstChild(toolName)
    if not toolFrame then return false end
    for _, skillKey in ipairs({"Z","X","C","V"}) do
        local skill = toolFrame:FindFirstChild(skillKey)
        if skill and skill:FindFirstChild("Cooldown") and skill.Cooldown:IsA("Frame") then
            if skill.Cooldown.Size.X.Scale == 1.0 then return true end
        end
    end
    return false
end

local function startSARender()
    if SA.RenderConn then return end
    SA.RenderConn = RunService.RenderStepped:Connect(function()
        if not CONFIG.SilentAimEnabled and not CONFIG.SORU_AimEnabled then return end
        local lpChar = lp.Character
        if not lpChar then return end
        local lpHRP = lpChar:FindFirstChild("HumanoidRootPart")
        if not lpHRP then return end
        if not CONFIG.SilentAimPlayers and not CONFIG.SilentAimNPCs then return end

        local targetModel, lookTargetPos = nil, nil
        if CONFIG.SilentAimPlayers then
            local tgt = getClosestPlayerForSA(lpHRP)
            if tgt and tgt ~= lp and tgt.Character then
                SA.PlayerTarget = tgt.Name
                SA.PlayerPos = getPredictedPosition(getHRP(tgt.Character))
                lookTargetPos = SA.PlayerPos
                targetModel = tgt.Character
                applySAHighlight(targetModel, "player")
            else
                SA.PlayerTarget, SA.PlayerPos = nil, nil
            end
        elseif SA.HighlightType == "player" then
            SA.PlayerTarget, SA.PlayerPos = nil, nil
            clearSAHighlight()
        end
        if CONFIG.SilentAimNPCs then
            local npc = getClosestNPCForSA(lpHRP)
            if npc then
                SA.NPCTarget = npc.Name
                SA.NPCPos = getPredictedPosition(getHRP(npc))
                lookTargetPos = SA.NPCPos
                if not targetModel then
                    targetModel = npc
                    applySAHighlight(targetModel, "NPC")
                end
            else
                SA.NPCTarget, SA.NPCPos = nil, nil
            end
        elseif SA.HighlightType == "NPC" then
            SA.NPCTarget, SA.NPCPos = nil, nil
            clearSAHighlight()
        end
        if SA.CurrentTool and lookTargetPos and isSkillReadyForTool(SA.CurrentTool.Name) then
            local lookVector = (Vector3.new(lookTargetPos.X, lpHRP.Position.Y, lookTargetPos.Z) - lpHRP.Position).Unit
            lpHRP.CFrame = CFrame.new(lpHRP.Position, lpHRP.Position + lookVector)
        end
    end)
end

local function stopSARender()
    if SA.RenderConn then SA.RenderConn:Disconnect(); SA.RenderConn = nil end
    clearSAHighlight()
end

local function installSAHooks()
    if SA.HooksInstalled then return end
    SA.HooksInstalled = true
    local ok, hookMeta = pcall(getrawmetatable, game)
    if not ok or not hookMeta then return end
    pcall(setreadonly, hookMeta, false)
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        local method = (getnamecallmethod and getnamecallmethod():lower()) or ""
        local args = {...}
        local V1 = args[1]
        local V2 = args[2]
        if CONFIG.SilentAimEnabled and tostring(self) == "RemoteEvent" and method == "fireserver" then
            if typeof(V1) == "Vector3" then
                if CONFIG.SilentAimPlayers and SA.PlayerPos then
                    return oldNamecall(self, SA.PlayerPos, V2, select(3, ...))
                elseif CONFIG.SilentAimNPCs and SA.NPCPos then
                    return oldNamecall(self, SA.NPCPos, V2, select(3, ...))
                end
            end
            if CONFIG.SilentAimZSkillM1 and type(V1) == "string" and V1 == "TAP" then
                if CONFIG.SilentAimPlayers and SA.PlayerPos then
                    return oldNamecall(self, V1, SA.PlayerPos, nil, select(3, ...))
                elseif CONFIG.SilentAimNPCs and SA.NPCPos then
                    return oldNamecall(self, V1, SA.NPCPos, nil, select(3, ...))
                end
            end
        end
        return oldNamecall(self, ...)
    end))
    pcall(setreadonly, hookMeta, true)
end

local function installSAMouseSpoof()
    if not MouseRef then return end
    RunService.Heartbeat:Connect(function()
        if not CONFIG.SilentAimEnabled or not CONFIG.SilentAimZSkillM1 then return end
        if not (CONFIG.SilentAimPlayers or CONFIG.SilentAimNPCs) then return end
        local targetCF = nil
        if SA.PlayerPos then targetCF = CFrame.new(SA.PlayerPos)
        elseif SA.NPCPos then targetCF = CFrame.new(SA.NPCPos) end
        if targetCF then
            pcall(function()
                MouseRef.Hit = targetCF
                MouseRef.Target = nil
            end)
        end
    end)
end

local function installSORUAimHook()
    if SA.SORU_HookInstalled then return end
    SA.SORU_HookInstalled = true
    local ok, mt = pcall(getrawmetatable, game)
    if not ok or not mt then return end
    local oldIndex = mt.__index
    pcall(setreadonly, mt, false)
    mt.__index = newcclosure(function(self, key)
        if CONFIG.SORU_AimEnabled and (key == "Hit" or key == "Target") then
            if self == lp:GetMouse() then
                local targetHRP = nil
                if SA.PlayerTarget then
                    local pl = Players:FindFirstChild(SA.PlayerTarget)
                    if pl and pl.Character then targetHRP = pl.Character:FindFirstChild("HumanoidRootPart") end
                elseif SA.NPCTarget then
                    local npcFolder = Workspace:FindFirstChild("Enemies")
                    if npcFolder then
                        local npc = npcFolder:FindFirstChild(SA.NPCTarget)
                        if npc then targetHRP = npc:FindFirstChild("HumanoidRootPart") end
                    end
                end
                if targetHRP then
                    if key == "Hit" then return CFrame.new(targetHRP.Position) end
                    if key == "Target" then return targetHRP end
                elseif SA.PlayerPos then
                    if key == "Hit" then return CFrame.new(SA.PlayerPos) end
                    if key == "Target" then return nil end
                elseif SA.NPCPos then
                    if key == "Hit" then return CFrame.new(SA.NPCPos) end
                    if key == "Target" then return nil end
                end
            end
        end
        return oldIndex(self, key)
    end)
    pcall(setreadonly, mt, true)
end

local function refreshSilentAim()
    if CONFIG.SilentAimEnabled then
        installSAHooks()
        installSAMouseSpoof()
    end
    if CONFIG.SilentAimEnabled or CONFIG.SORU_AimEnabled then
        startSARender()
    else
        stopSARender()
    end
    if CONFIG.SORU_AimEnabled then installSORUAimHook() end
    getgenv().soruAimEnabled = CONFIG.SORU_AimEnabled
end

