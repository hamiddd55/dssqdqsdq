local function randomVector()
    local s = 1e38
    local function sgn() return math.random(0, 1) == 1 and 1 or -1 end
    return Vector3.new(sgn() * s, sgn() * s, sgn() * s)
end

local function getActiveVector()
    local v = VECTORS[CONFIG.FruitVectorIdx]
    if not v then return Vector3.new(9e30, 9e30, 9e30), "?" end
    local vec = v.vector
    if not vec then vec = randomVector() end
    return vec, v.name
end

