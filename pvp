-- ═══════════════════════════════════════════════════════════
local function getMyHRP()
    local char = lp.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function getTpPlayerList()
    local list = {}
    local myHrp = getMyHRP()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= lp and p.Character then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            if hum and hrp then
                local dist = 0
                if myHrp then
                    dist = (hrp.Position - myHrp.Position).Magnitude
                end
                table.insert(list, {
                    player = p,
                    name = p.Name,
                    health = math.floor(hum.Health),
                    distance = math.floor(dist),
                    inRange = dist <= CONFIG.TpMaxDistance,
                })
            end
        end
    end
    table.sort(list, function(a, b) return a.distance < b.distance end)
    return list
end

local function doInstantTP()
    if not State.TpTarget then return false, "No target" end
    local tChar = State.TpTarget.Character
    if not tChar then return false, "Target left" end
    local myHrp = getMyHRP()
    if not myHrp then return false, "No character" end
    local tHrp = tChar:FindFirstChild("HumanoidRootPart")
    if not tHrp then return false, "No HRP" end

    local dist = (tHrp.Position - myHrp.Position).Magnitude
    if dist > CONFIG.TpMaxDistance then
        return false, string.format("Too far (%.0f > %d)", dist, CONFIG.TpMaxDistance)
    end

    local tPos = tHrp.Position
    local targetCF = CFrame.new(tPos, tPos + tHrp.CFrame.LookVector)

    pcall(function()
        myHrp.CFrame = targetCF
        myHrp.Velocity = Vector3.zero
        myHrp.AssemblyLinearVelocity = Vector3.zero
    end)

    State.TpCount = State.TpCount + 1
    return true, string.format("TP'd to %s (%.0f studs)", State.TpTarget.Name, dist)
end

local function startTpLoop()
    if State.TpThread then task.cancel(State.TpThread) end
    State.TpThread = task.spawn(function()
        while CONFIG.TpEnabled do
            task.wait(CONFIG.TpInterval)
            pcall(doInstantTP)
        end
    end)
end

local function stopTpLoop()
    CONFIG.TpEnabled = false
    if State.TpThread then
        task.cancel(State.TpThread)
        State.TpThread = nil
    end
end

