-- ═══════════════════════════════════════════════════════════
-- FAST ATTACK (Melee)
-- ═══════════════════════════════════════════════════════════
local function fireAttack(target)
    if not target or not State.RegisterHit or not State.RegisterAttack then return end
    local head = target:FindFirstChild("Head") or target:FindFirstChild("HumanoidRootPart")
    if not head then return end
    pcall(function()
        State.RegisterAttack:FireServer(0)
        State.RegisterHit:FireServer(head, {{target, head}})
    end)
end

local function startAttack()
    if State.AttackConn then State.AttackConn:Disconnect() end
    State.AttackConn = RunService.Heartbeat:Connect(function()
        if not CONFIG.AttackEnable then return end
        if not (State.RegisterHit and State.RegisterAttack) then return end
        task.wait(CONFIG.AttackDelay)
        local myRoot = State.Root
        if not myRoot then return end
        if CONFIG.TargetNPCs then
            local en = Workspace:FindFirstChild("Enemies")
            if en then
                for _, npc in ipairs(en:GetChildren()) do
                    if npc.Name == "Player" then continue end
                    local hrp = npc:FindFirstChild("HumanoidRootPart")
                    local hum = npc:FindFirstChildOfClass("Humanoid")
                    if hrp and hum and hum.Health > 0 then
                        if (hrp.Position - myRoot.Position).Magnitude <= CONFIG.AttackRange then
                            fireAttack(npc)
                        end
                    end
                end
            end
        end
        if CONFIG.TargetPlayers then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= lp and p.Character then
                    local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                    local hum = p.Character:FindFirstChildOfClass("Humanoid")
                    if hrp and hum and hum.Health > 0 then
                        if (hrp.Position - myRoot.Position).Magnitude <= CONFIG.AttackRange then
                            fireAttack(p.Character)
                        end
                    end
                end
            end
        end
    end)
    print("[SORU] ⚔️ Fast Attack: ON | Range:", CONFIG.AttackRange)
end

local function stopAttack()
    CONFIG.AttackEnable = false
    if State.AttackConn then State.AttackConn:Disconnect(); State.AttackConn = nil end
    print("[SORU] 🛑 Fast Attack: OFF")
end

