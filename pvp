local function getTeamInfo(player)
    if not player.Team then return "Unknown", Color3.fromRGB(255,255,255) end
    if player.Team.Name == "Marines" then return "Marines", Color3.fromRGB(0, 170, 255) end
    if player.Team.Name == "Pirates" then return "Pirates", Color3.fromRGB(255, 70, 70) end
    return player.Team.Name, Color3.fromRGB(200, 200, 200)
end

local function removeESP(player)
    if State.ESPCache[player] then
        pcall(function()
            if State.ESPCache[player].gui then State.ESPCache[player].gui:Destroy() end
            if State.ESPCache[player].highlight then State.ESPCache[player].highlight:Destroy() end
        end)
        State.ESPCache[player] = nil
    end
end

local function createESP(player)
    if player == lp then return end
    local char = player.Character
    if not char then return end
    local head = char:FindFirstChild("Head")
    if not head then return end
    local team, color = getTeamInfo(player)
    local bb = Instance.new("BillboardGui")
    bb.Adornee = head
    bb.Size = UDim2.new(0, 220, 0, 80)
    bb.StudsOffset = Vector3.new(0, 3, 0)
    bb.AlwaysOnTop = true
    local text = Instance.new("TextLabel", bb)
    text.Size = UDim2.new(1, 0, 1, 0)
    text.BackgroundTransparency = 1
    text.TextSize = CONFIG.ESPTextSize
    text.RichText = true
    text.Font = Enum.Font.SourceSansBold
    text.TextStrokeTransparency = 0
    text.TextColor3 = color
    text.Text = ""
    bb.Parent = head
    local highlight = nil
    if CONFIG.ESPHighlight then
        highlight = Instance.new("Highlight")
        highlight.Name = "SORU_HL"
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.FillColor = CONFIG.ESPHighlightColor
        highlight.OutlineColor = CONFIG.ESPHighlightColor
        highlight.FillTransparency = 0.5
        highlight.Parent = char
    end
    State.ESPCache[player] = { gui = bb, label = text, char = char, highlight = highlight, lastUpdate = 0, data = {} }
end

local function updateESP()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= lp then
            local char = player.Character
            local head = char and char:FindFirstChild("Head")
            local cache = State.ESPCache[player]
            if char and head then
                if not cache or cache.char ~= char or not cache.gui.Parent then
                    removeESP(player)
                    createESP(player)
                    cache = State.ESPCache[player]
                end
                if cache then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    local root = char:FindFirstChild("HumanoidRootPart")
                    if hum and root and State.Root then
                        local now = tick()
                        if now - cache.lastUpdate > 3 then
                            cache.lastUpdate = now
                            pcall(function() cache.data.level = player.Data.Level.Value end)
                            pcall(function() cache.data.fruit = player.Data.DevilFruit.Value end)
                            pcall(function() cache.data.bounty = player.leaderstats["Bounty/Honor"].Value end)
                        end
                        local dist = math.floor((root.Position - State.Root.Position).Magnitude)
                        local hp = math.floor((hum.Health / hum.MaxHealth) * 100)
                        local team, color = getTeamInfo(player)
                        local level = cache.data.level or "?"
                        local fruit = cache.data.fruit or "None"
                        local bounty = cache.data.bounty or 0
                        local isPvpDisabled = player:GetAttribute("PvpDisabled") == true
                        local pvpText = isPvpDisabled and "🟢 PvP Off" or "🔴 PvP On"
                        local parts = {}
                        if CONFIG.ESPTeam then parts[#parts+1] = "[" .. team .. "] " end
                        if CONFIG.ESPName then parts[#parts+1] = "<font color=\"rgb(255,255,0)\">" .. player.Name .. "</font>" end
                        if CONFIG.ESPLevel then parts[#parts+1] = " [Lv." .. level .. "]" end
                        if CONFIG.ESPPvP then parts[#parts+1] = "\n" .. pvpText .. "\n" end
                        if CONFIG.ESPFruit then parts[#parts+1] = "Fruit: " .. fruit .. "\n" end
                        if CONFIG.ESPBounty then parts[#parts+1] = "Bounty: " .. math.floor(bounty / 1000000) .. "M\n" end
                        if CONFIG.ESPDistance then parts[#parts+1] = dist .. " studs | " end
                        if CONFIG.ESPHP then parts[#parts+1] = "HP: " .. hp .. "%" end
                        cache.label.Text = table.concat(parts)
                        cache.label.TextColor3 = color
                        cache.label.TextSize = CONFIG.ESPTextSize
                        if cache.highlight then
                            cache.highlight.FillColor = CONFIG.ESPHighlightColor
                            cache.highlight.OutlineColor = CONFIG.ESPHighlightColor
                        end
                    end
                end
            else
                if cache then removeESP(player) end
            end
        end
    end
end

task.spawn(function()
    while task.wait(0.15) do
        if CONFIG.ESPEnabled then
            pcall(updateESP)
        else
            for player in pairs(State.ESPCache) do removeESP(player) end
        end
    end
end)

