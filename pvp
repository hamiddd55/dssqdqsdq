local function startFruitM1()
    CONFIG.FruitM1Enabled = true
    if State.FruitThread then task.cancel(State.FruitThread) end

    State.FruitThread = task.spawn(function()
        while CONFIG.FruitM1Enabled do
            task.wait(CONFIG.FruitM1Interval)

            local fruit = getPlayerFruit()
            if not fruit then continue end

            -- 🦊 Kitsune Support
            if fruit.Name:find("Kitsune") then
                local m1 = fruit:FindFirstChild("M1Active")
                if m1 and m1:IsA("BoolValue") and not m1.Value then
                    pcall(function() m1.Value = true end)
                end

                local char = lp.Character
                local myHRP = char and char:FindFirstChild("HumanoidRootPart")
                if not myHRP then continue end
                local myPos = myHRP.Position

                local main = fruit:FindFirstChild("RemoteEvent")
                local lc = fruit:FindFirstChild("LeftClickRemote")

                if CONFIG.FruitM1TargetPlayers then
                    for _, player in pairs(Players:GetPlayers()) do
                        if player ~= lp and player.Character then
                            local targetHRP = player.Character:FindFirstChild("HumanoidRootPart")
                            local hum = player.Character:FindFirstChild("Humanoid")
                            if targetHRP and hum and hum.Health > 0
                                and (targetHRP.Position - myPos).Magnitude < CONFIG.FruitM1Range then
                                local dir = (targetHRP.Position - myPos).Unit
                                local dirVec = Vector3.new(dir.X, dir.Y, dir.Z)
                                if main then pcall(function() main:FireServer("M1", 1, true) end) end
                                if lc then pcall(function() lc:FireServer(dirVec, 1, true) end) end
                            end
                        end
                    end
                end

                if CONFIG.FruitM1TargetNPCs then
                    local enemiesFolder = Workspace:FindFirstChild("Enemies")
                    if enemiesFolder then
                        for _, npc in pairs(enemiesFolder:GetChildren()) do
                            local targetHRP = npc:FindFirstChild("HumanoidRootPart")
                            local hum = npc:FindFirstChild("Humanoid")
                            if targetHRP and hum and hum.Health > 0
                                and (targetHRP.Position - myPos).Magnitude < CONFIG.FruitM1Range then
                                local dir = (targetHRP.Position - myPos).Unit
                                local dirVec = Vector3.new(dir.X, dir.Y, dir.Z)
                                if main then pcall(function() main:FireServer("M1", 1, true) end) end
                                if lc then pcall(function() lc:FireServer(dirVec, 1, true) end) end
                            end
                        end
                    end
                end
                continue
            end

            -- فواكه عادية (10 Vectors)
            local remote = fruit:FindFirstChild("LeftClickRemote")
            if not remote then continue end

            local char = lp.Character
            local myHRP = char and char:FindFirstChild("HumanoidRootPart")
            if not myHRP then continue end
            local myPos = myHRP.Position

            local vector = getActiveVector()
            local sent = 0

            if CONFIG.FruitM1TargetPlayers then
                for _, player in pairs(Players:GetPlayers()) do
                    if player ~= lp and player.Character then
                        local targetHRP = player.Character:FindFirstChild("HumanoidRootPart")
                        local hum = player.Character:FindFirstChild("Humanoid")
                        if targetHRP and hum and hum.Health > 0
                            and (targetHRP.Position - myPos).Magnitude < CONFIG.FruitM1Range then
                            pcall(function()
                                remote:FireServer(vector, CONFIG.FruitCombo, CONFIG.FruitBool)
                            end)
                            sent = sent + 1
                        end
                    end
                end
            end

            if CONFIG.FruitM1TargetNPCs then
                local enemiesFolder = Workspace:FindFirstChild("Enemies")
                if enemiesFolder then
                    for _, npc in pairs(enemiesFolder:GetChildren()) do
                        local targetHRP = npc:FindFirstChild("HumanoidRootPart")
                        local hum = npc:FindFirstChild("Humanoid")
                        if targetHRP and hum and hum.Health > 0
                            and (targetHRP.Position - myPos).Magnitude < CONFIG.FruitM1Range then
                            pcall(function()
                                remote:FireServer(vector, CONFIG.FruitCombo, CONFIG.FruitBool)
                            end)
                            sent = sent + 1
                        end
                    end
                end
            end

            if CONFIG.FruitAutoCycle and sent > 0 then
                State.FruitCycleCounter = State.FruitCycleCounter + 1
                if State.FruitCycleCounter >= CONFIG.FruitCycleSpeed then
                    State.FruitCycleCounter = 0
                    CONFIG.FruitVectorIdx = (CONFIG.FruitVectorIdx % #VECTORS) + 1
                    if _G.SORU_UpdateVectorUI then _G.SORU_UpdateVectorUI() end
                end
            end
        end
    end)

    print("[SORU] 🍎 Fruit M1: ON | Vector:", VECTORS[CONFIG.FruitVectorIdx].name)
end

