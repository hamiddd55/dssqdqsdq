local function onChar(c)
    State.Char = c
    State.Root = c:WaitForChild("HumanoidRootPart", 10)
    State.Hum = c:WaitForChild("Humanoid", 10)
    task.wait(0.5)
    if CONFIG.InfFlashstep and c then
        c:SetAttribute("FlashstepCooldown", 1)
    end
    for _, conn in ipairs(State.SA.CharacterConns) do pcall(function() conn:Disconnect() end) end
    State.SA.CharacterConns = {}
    for _, child in ipairs(c:GetChildren()) do
        if child:IsA("Tool") then State.SA.CurrentTool = child end
    end
    table.insert(State.SA.CharacterConns, c.ChildAdded:Connect(function(child)
        if child:IsA("Tool") then State.SA.CurrentTool = child end
    end))
    table.insert(State.SA.CharacterConns, c.ChildRemoved:Connect(function(child)
        if child == State.SA.CurrentTool then State.SA.CurrentTool = nil end
    end))
end
