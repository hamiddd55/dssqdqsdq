end

-- ═══════════════════════════════════════════════════════════
-- HITBOX
-- ═══════════════════════════════════════════════════════════
local HB_PARTS = {"HumanoidRootPart", "Head", "UpperTorso", "LowerTorso", "Torso"}

local function expandHitbox(part)
    if not part or not part:IsA("BasePart") then return end
    if not State.HitboxOriginals[part] then
        State.HitboxOriginals[part] = {
            Size = part.Size, Transparency = part.Transparency, CanCollide = part.CanCollide,
        }
    end
    local o = State.HitboxOriginals[part]
    part.Size = o.Size * CONFIG.HitboxSize
    part.Transparency = 1
    part.CanCollide = false
end

local function restoreHitbox(part)
    if not part or not part.Parent then return end
    local o = State.HitboxOriginals[part]
    if not o then return end
    pcall(function()
        part.Size = o.Size
        part.Transparency = o.Transparency
        part.CanCollide = o.CanCollide
    end)
    State.HitboxOriginals[part] = nil
end

local function startHitbox()
    if State.HitboxThread then task.cancel(State.HitboxThread) end
    State.HitboxThread = task.spawn(function()
        while CONFIG.HitboxEnabled do
            task.wait(0.1)
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= lp and p.Character then
                    local sameTeam = CONFIG.HitboxTeamCheck and p.Team and lp.Team and p.Team == lp.Team
                    if not sameTeam then
                        for _, name in ipairs(HB_PARTS) do
                            local part = p.Character:FindFirstChild(name)
                            if part then expandHitbox(part) end
                        end
                    end
                end
            end
            if CONFIG.HitboxNPCs then
                local en = Workspace:FindFirstChild("Enemies")
                if en then
                    for _, npc in ipairs(en:GetChildren()) do
                        if npc:IsA("Model") and npc.Name ~= "Player" then
                            for _, name in ipairs(HB_PARTS) do
                                local part = npc:FindFirstChild(name)
                                if part then expandHitbox(part) end
                            end
                        end
                    end
                end
            end
        end
    end)
    print("[SORU] 📦 Hitbox: ON | Size:", CONFIG.HitboxSize)
end

local function stopHitbox()
    CONFIG.HitboxEnabled = false
    if State.HitboxThread then task.cancel(State.HitboxThread); State.HitboxThread = nil end
    for part in pairs(State.HitboxOriginals) do restoreHitbox(part) end
    print("[SORU] 🛑 Hitbox: OFF")
end

